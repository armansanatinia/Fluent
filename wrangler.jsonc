// Fluent — Cloudflare Worker: serves the app and answers /api/* (sync, AI, images).
//
// Deploys from GitHub through Cloudflare (Workers & Pages → Import a repository),
// or by hand with `npm run deploy`. The first deploy creates the D1 database by
// itself (no database_id needed), and the worker creates its table on first use.
//
// Secrets, set in the dashboard (Worker → Settings → Variables and Secrets) or with wrangler:
//   SYNC_TOKEN          a long password; you type it on each device to sync
//   ANTHROPIC_API_KEY   optional, turns on the AI helper
//
// Local: npm run dev (Vite + the worker together). The local database also sets itself up.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fluent"
    }
  ],
  // The app's address. armansanatinia.com must be added to the same Cloudflare account.
  "routes": [{ "pattern": "fluent.armansanatinia.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
